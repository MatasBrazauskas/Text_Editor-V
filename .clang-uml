compilation_database_dir: build
output_directory: docs/diagrams

diagrams:
  editor_structure:
    type: class
    glob:
      - src/**/*.cpp
      - src/**/*.hpp
    exclude:
      paths:
        - src/includes/**
      namespaces:
        - std
        - SDL
      dependencies:
        - system

  keyboard_input_flow:
    type: sequence
    glob:
      - src/core/main.cpp
      - src/core/NormalMode.cpp
    start_from:
      - function: "main"
    exclude:
      paths:
        - src/includes/**
      namespaces:
        - std
        - SDL