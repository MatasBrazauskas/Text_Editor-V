{
  "window": 
  {
    "title": "Text Editor",
    "width": 1280,
    "height": 720,
    "fps_limit": 60
  },
  "editor": 
  {
    "feel": 
    {
      "tab_size": 8,
      "auto_save": 
      {
        "enabled": false, 
        "interval_s": 30 
      },
      "cursor_blink_ms": 1000,
      "wrap_text": false
    },
    "view": 
    {
      "vertical_ruler": 
      { 
        "enabled": true,
        "column": 80 
      },
      "line_number_mode": "relative"
    }
  },
  "fonts": 
  {
    "code": 
    {
      "path": "fonts/JetBrainsMono-ExtraLight.ttf",
      "size": 19
    },
    "ui": 
    {
      "path": "fonts/JetBrainsMono-Medium.ttf",
      "size": 19
    }
    },
  "theme": 
  {
    "code_text" : "ffffff",
    "background": "222436",
    "foreground": "1b1e1d",
    "ui_text": "ffffff",
    "main": "1b1f23",
    "secondary": "0e004e",
    "cursor": "ffffff",
    "highlight": "000000"
  }
}
